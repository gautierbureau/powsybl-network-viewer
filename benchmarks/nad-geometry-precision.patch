@@ -437,6 +439,22 @@ public class SvgParameters {
         return this;
     }
 
+    public int getGeometryPrecision() {
+        return geometryPrecision;
+    }
+
+    /**
+     * Number of decimal places used when writing SVG geometry coordinates (positions, radii,
+     * paths, transforms). Diagram coordinates are typically in the thousands, where 2 decimals is
+     * sub-pixel once the viewBox is scaled to screen; lowering this shrinks the SVG (smaller
+     * transfer and faster client-side parsing) at the cost of geometric precision. Defaults to 2,
+     * which reproduces the previous output.
+     */
+    public SvgParameters setGeometryPrecision(int geometryPrecision) {
+        this.geometryPrecision = geometryPrecision;
+        return this;
+    }
+
     public ValueFormatter createValueFormatter() {
         return new ValueFormatter(powerValuePrecision, voltageValuePrecision, currentValuePrecision, angleValuePrecision,
             percentageValuePrecision, Locale.forLanguageTag(languageTag), undefinedValueSymbol);
